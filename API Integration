var HREmployeeIntegration = Class.create();

HREmployeeIntegration.prototype = {

    initialize: function() {},

    getEmployee: function(employeeId) {

        if (!/^[A-Za-z0-9_-]+$/.test(String(employeeId))) {
            throw new Error('Invalid employee ID');
        }

        var rest = new sn_ws.RESTMessageV2(
            'HR Employee Integration',
            'get'
        );

        rest.setStringParameterNoEscape(
            'employee_id',
            encodeURIComponent(String(employeeId))
        );

        rest.setHttpTimeout(15000);

        var result = rest.execute();

        if (result.getStatusCode() !== 200) {
            throw new Error(
                'HR API failed: HTTP ' + result.getStatusCode()
            );
        }

        var employee = JSON.parse(result.getBody());

        return {
            employeeId: employee.employeeId,
            active: employee.active === true,
            department: employee.department,
            managerId: employee.managerId
        };
    },

    type: 'HREmployeeIntegration'
};


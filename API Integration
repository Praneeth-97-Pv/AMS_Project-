#Script Include — DeliveryImpactCalculator

var DeliveryImpactCalculator = Class.create();

DeliveryImpactCalculator.prototype = {

    initialize: function() {},

    calculate: function(eta, windowHours, rate) {

        eta = Number(eta);
        windowHours = Number(windowHours);
        rate = Number(rate);

        if (!isFinite(eta) ||
            !isFinite(windowHours) ||
            !isFinite(rate) ||
            eta < 0 || windowHours < 0 || rate < 0) {

            throw new Error('Invalid numeric inputs');
        }

        var allowedMinutes = windowHours * 60;
        var delayedMinutes = Math.max(
            0,
            eta - allowedMinutes
        );

        var impact = Math.round(
            delayedMinutes * rate * 100
        ) / 100;

        return {
            delayed: delayedMinutes > 0,
            delay_minutes: delayedMinutes,
            calculated_impact: impact,
            status: delayedMinutes > 0 ?
                'delayed' : 'on_time'
        };
    },

    type: 'DeliveryImpactCalculator'
};

#Scripted REST API

(function process(request, response) {

    if (!gs.hasRole('x_demo.route_integration')) {
        response.setStatus(403);
        response.setBody({ error: 'Forbidden' });
        return;
    }

    var body = request.body.data || {};
    var routeId = String(body.route_id || '');

    if (!/^[A-Za-z0-9_-]+$/.test(routeId)) {
        response.setStatus(400);
        response.setBody({ error: 'Invalid route ID' });
        return;
    }

    var calculation;

    try {
        var calculator = new DeliveryImpactCalculator();

        calculation = calculator.calculate(
            body.eta_minutes,
            body.delivery_window_hours,
            body.penalty_rate
        );
    } catch (ex) {
        response.setStatus(400);
        response.setBody({
            error: 'Invalid delivery calculation data'
        });
        return;
    }

    var record = new GlideRecordSecure(
        'x_demo_delivery_delay'
    );

    record.addQuery('u_route_id', routeId);
    record.setLimit(1);
    record.query();

    var isNew = !record.next();

    if (isNew) {
        record.initialize();
        record.setValue('u_route_id', routeId);
    }

    record.setValue('u_eta_minutes',
        Number(body.eta_minutes));
    record.setValue('u_delivery_window_hours',
        Number(body.delivery_window_hours));
    record.setValue('u_penalty_rate',
        Number(body.penalty_rate));
    record.setValue('u_delay_minutes',
        calculation.delay_minutes);
    record.setValue('u_calculated_impact',
        calculation.calculated_impact);
    record.setValue('u_status', calculation.status);

    var sysId = isNew ? record.insert() : record.update();

    if (!sysId) {
        response.setStatus(500);
        response.setBody({
            error: 'Unable to save route calculation'
        });
        return;
    }

    response.setStatus(isNew ? 201 : 200);
    response.setBody({
        route_id: routeId,
        delay_minutes: calculation.delay_minutes,
        calculated_impact: calculation.calculated_impact,
        status: calculation.status,
        record_id: String(sysId)
    });

})(request, response);


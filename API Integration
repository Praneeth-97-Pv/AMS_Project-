var DeliveryStatusIntegration = Class.create();

DeliveryStatusIntegration.prototype = {

    initialize: function() {},

    updateStatus: function(routeId, status) {

        if (!/^[A-Za-z0-9_-]+$/.test(String(routeId))) {
            throw new Error('Invalid route ID');
        }

        var allowed = {
            dispatched: true,
            delayed: true,
            on_time: true
        };

        if (!allowed[status]) {
            throw new Error('Invalid delivery status');
        }

        var rest = new sn_ws.RESTMessageV2(
            'Delivery Instance Integration',
            'patch'
        );

        rest.setRequestHeader(
            'Content-Type',
            'application/json'
        );

        rest.setRequestBody(JSON.stringify({
            route_id: String(routeId),
            status: status
        }));

        rest.setHttpTimeout(15000);

        var result = rest.execute();
        var httpStatus = result.getStatusCode();

        if (httpStatus !== 200) {
            gs.error(
                'Delivery status update failed: HTTP ' +
                httpStatus
            );

            throw new Error('Delivery synchronization failed');
        }

        return JSON.parse(result.getBody());
    },

    type: 'DeliveryStatusIntegration'
};


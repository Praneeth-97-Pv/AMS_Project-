(function process(request, response) {

    if (!gs.hasRole('x_demo.delivery_integration')) {
        response.setStatus(403);
        response.setBody({ error: 'Forbidden' });
        return;
    }

    var body = request.body.data || {};
    var routeId = String(body.route_id || '');
    var status = String(body.status || '');

    var allowed = {
        dispatched: true,
        delayed: true,
        on_time: true
    };

    if (!/^[A-Za-z0-9_-]+$/.test(routeId) ||
        !allowed[status]) {
        response.setStatus(400);
        response.setBody({
            error: 'Invalid route or status'
        });
        return;
    }

    var delivery = new GlideRecordSecure(
        'x_demo_delivery_delay'
    );

    delivery.addQuery('u_route_id', routeId);
    delivery.setLimit(1);
    delivery.query();

    if (!delivery.next()) {
        response.setStatus(404);
        response.setBody({
            error: 'Route not found'
        });
        return;
    }

    // Check approved transitions in production.
    delivery.setValue('u_status', status);

    if (!delivery.update()) {
        response.setStatus(500);
        response.setBody({
            error: 'Status update failed'
        });
        return;
    }

    response.setStatus(200);
    response.setBody({
        route_id: routeId,
        status: status,
        synchronized: true
    });

})(request, response);

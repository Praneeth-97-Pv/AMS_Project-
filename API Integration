               ###Care Agent Onboarding Portal###

(function process(request, response) {

    if (!gs.hasRole('x_demo.onboarding_integration')) {
        response.setStatus(403);
        response.setBody({ error: 'Forbidden' });
        return;
    }

    var data = request.body.data || {};
    var employeeId = String(data.employee_id || '').trim();
    var email = String(data.email || '').trim();

    if (!employeeId || !email ||
        !data.first_name || !data.last_name ||
        !data.manager_id) {

        response.setStatus(400);
        response.setBody({
            error: 'Required onboarding fields are missing'
        });
        return;
    }

    var existing = new GlideRecordSecure(
        'x_demo_agent_onboarding'
    );

    existing.addQuery('u_employee_id', employeeId);
    existing.setLimit(1);
    existing.query();

    if (existing.next()) {
        response.setStatus(409);
        response.setBody({
            error: 'Onboarding request already exists',
            request_id: existing.getUniqueValue()
        });
        return;
    }

    // Approved roles must be validated against a
    // server-controlled role mapping.
    if (data.requested_role !== 'care_agent') {
        response.setStatus(400);
        response.setBody({
            error: 'Unsupported requested role'
        });
        return;
    }

    var agent = new GlideRecordSecure(
        'x_demo_agent_onboarding'
    );

    agent.initialize();
    agent.setValue('u_employee_id', employeeId);
    agent.setValue('u_first_name', String(data.first_name));
    agent.setValue('u_last_name', String(data.last_name));
    agent.setValue('u_email', email);
    agent.setValue('u_manager_id', String(data.manager_id));
    agent.setValue('u_requested_role', 'care_agent');
    agent.setValue('u_status', 'pending_approval');

    var sysId = agent.insert();

    if (!sysId) {
        response.setStatus(500);
        response.setBody({
            error: 'Unable to create onboarding request'
        });
        return;
    }

    response.setStatus(201);
    response.setBody({
        request_id: String(sysId),
        employee_id: employeeId,
        status: 'pending_approval',
        message: 'Onboarding request created'
    });

})(request, response);

